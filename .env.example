VITE_SUPABASE_URL=https://YOUR_INDEPENDENT_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLIC_KEY
